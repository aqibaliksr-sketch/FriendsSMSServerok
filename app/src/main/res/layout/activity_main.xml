<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="FriendsSoft SMS Server" android:textSize="26sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Send SMS from your Android phone through the FriendsSoft software." android:textSize="15sp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/status" android:text="Server stopped" android:textSize="18sp" android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/port" android:inputType="number" android:text="3000" android:hint="Port" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/start" android:text="START SERVER" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/stop" android:text="STOP SERVER" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="API: POST /v1/sms or /send-message\nBody: {&quot;number&quot;:&quot;03xxxxxxxxx&quot;,&quot;message&quot;:&quot;Hello&quot;}\nMake sure SMS permission is Allowed." android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
